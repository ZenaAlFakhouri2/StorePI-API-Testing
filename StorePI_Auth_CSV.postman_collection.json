{
  "info": {
    "name": "StorePI Auth CSV",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login - CSV Driven",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var expected = parseInt(pm.iterationData.get(\"expectedStatus\"), 10);",
              "var scenario = pm.iterationData.get(\"scenario\");",
              "pm.test(\"[\" + scenario + \"] status is \" + expected, function () {",
              "    pm.response.to.have.status(expected);",
              "});",
              "if (expected === 200) {",
              "    pm.test(\"[\" + scenario + \"] returns access_token\", function () {",
              "        var json = pm.response.json();",
              "        pm.expect(json.data.access_token).to.be.a(\"string\").and.not.empty;",
              "        pm.environment.set(\"access_token\", json.data.access_token);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "response": []
    }
  ]
}
